table Product

	column ProductKey
		dataType: int64
		summarizeBy: none
		sourceColumn: product_key

	column ProductName
		dataType: string
		sourceColumn: product_name

	column Category
		dataType: string
		sourceColumn: category

	partition Product = entity
		mode: directLake
		source
			entityName: Product
			schemaName: gold
			expressionSource: DL_Lakehouse
