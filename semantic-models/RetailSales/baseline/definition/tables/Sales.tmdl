table Sales

	column SalesKey
		dataType: int64
		sourceColumn: sales_key

	column DateKey
		dataType: int64
		sourceColumn: date_key

	column CustomerKey
		dataType: int64
		sourceColumn: customer_key

	column ProductKey
		dataType: int64
		sourceColumn: product_key

	column PurchaseId
		dataType: string
		sourceColumn: purchase_id

	column Revenue
		dataType: decimal
		sourceColumn: revenue

	column Cost
		dataType: decimal
		sourceColumn: cost

	measure Revenue = SUM(Sales[Revenue])
		formatString: $#,##0.00;($#,##0.00)

	measure MarginPct = DIVIDE(SUM(Sales[Revenue]) - SUM(Sales[Cost]), SUM(Sales[Revenue]))
		formatString: 0.00%

	partition Sales = entity
		mode: directLake
		source
			entityName: Sales
			schemaName: gold
			expressionSource: DL_Lakehouse
