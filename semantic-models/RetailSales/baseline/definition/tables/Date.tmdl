table Date

	column DateKey
		dataType: int64
		summarizeBy: none
		sourceColumn: date_key

	column Date
		dataType: dateTime
		sourceColumn: date_value

	column Year
		dataType: int64
		sourceColumn: calendar_year

	column MonthName
		dataType: string
		sourceColumn: month_name

	partition Date = entity
		mode: directLake
		source
			entityName: Date
			schemaName: gold
			expressionSource: DL_Lakehouse
