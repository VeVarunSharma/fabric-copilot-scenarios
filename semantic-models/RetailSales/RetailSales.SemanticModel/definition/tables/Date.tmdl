table Date

	column 'Date Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: date_key

	/// Calendar date at daily grain.
	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date_value

	/// Calendar year for time intelligence analysis.
	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: calendar_year

	/// Calendar quarter label.
	column Quarter
		dataType: string
		summarizeBy: none
		sourceColumn: calendar_quarter

	/// Calendar month number used for ordering.
	column 'Month Number'
		dataType: int64
		summarizeBy: none
		sourceColumn: month_number

	/// Calendar month name.
	column 'Month Name'
		dataType: string
		summarizeBy: none
		sourceColumn: month_name

	/// Combined year-month label.
	column 'Year Month'
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	hierarchy 'Calendar Hierarchy'
		level Year
			column: Year
		level Quarter
			column: Quarter
		level 'Month Name'
			column: 'Month Name'
		level Date
			column: Date

	partition Date = entity
		mode: directLake
		source
			entityName: Date
			schemaName: gold
			expressionSource: DL_RetailLakehouse
