table Product

	column 'Product Key'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	/// Stable product identifier.
	column 'Product ID'
		dataType: string
		summarizeBy: none
		sourceColumn: product_id

	/// Product display name used in reports and Copilot prompts.
	column 'Product Name'
		dataType: string
		summarizeBy: none
		sourceColumn: product_name

	/// Product category.
	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	/// Product subcategory.
	column Subcategory
		dataType: string
		summarizeBy: none
		sourceColumn: subcategory

	/// Standard unit price attribute from the product dimension.
	column 'Unit Price'
		dataType: decimal
		formatString: $#,##0.00;($#,##0.00)
		summarizeBy: none
		sourceColumn: unit_price

	/// Standard unit cost attribute from the product dimension.
	column 'Unit Cost'
		dataType: decimal
		formatString: $#,##0.00;($#,##0.00)
		summarizeBy: none
		sourceColumn: unit_cost

	/// Product active flag.
	column 'Is Active'
		dataType: boolean
		summarizeBy: none
		sourceColumn: is_active

	column 'Synthetic Record'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: synthetic_record

	partition Product = entity
		mode: directLake
		source
			entityName: Product
			schemaName: gold
			expressionSource: DL_RetailLakehouse
